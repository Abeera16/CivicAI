# ==== General ====
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==== Postgres ====
POSTGRES_USER=civicai
POSTGRES_PASSWORD=civicai_pass
POSTGRES_DB=civicai
DATABASE_URL=postgresql+asyncpg://civicai:civicai_pass@postgres:5432/civicai

# ==== LLM Provider ====
# "groq" = free-tier friendly (default), "openai" = paid OpenAI
LLM_PROVIDER=groq

# ==== Groq (get a free key at https://console.groq.com/keys) ====
GROQ_API_KEY=gsk-your-groq-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ==== OpenAI (only needed if LLM_PROVIDER=openai) ====
OPENAI_API_KEY=sk-your-openai-key
OPENAI_CHAT_MODEL=gpt-4o-mini

# ==== LangSmith (optional — set LANGCHAIN_TRACING_V2=true to enable) ====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls-your-langsmith-key
LANGCHAIN_PROJECT=civicai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ==== JWT ====
JWT_SECRET_KEY=change_this_super_secret_key_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== Weather / AQI ====
# provider: "openweathermap" (default, free tier) or "iqair"
WEATHER_PROVIDER=openweathermap
OPENWEATHERMAP_API_KEY=your-openweathermap-key
IQAIR_API_KEY=your-iqair-key

# ==== Admin seed (optional — creates a staff account on first startup) ====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your-admin-password

# ==== Frontend ====
NEXT_PUBLIC_CIVICAI_API_URL=http://localhost:8000/api
